# Copy to .env before running `docker compose up`.
# Every value below has a working default in docker-compose.yml; this file
# documents the full configuration surface.

# --- Database ----------------------------------------------------------------
POSTGRES_USER=codity
POSTGRES_PASSWORD=codity_dev_password
POSTGRES_DB=codity
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- API ---------------------------------------------------------------------
API_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Auth --------------------------------------------------------------------
# CHANGE THIS. Generate with: openssl rand -hex 32
JWT_SECRET_KEY=dev_only_secret_change_me_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Worker (used from Day 1) ------------------------------------------------
WORKER_CONCURRENCY=10
WORKER_POLL_INTERVAL_MS=100
WORKER_POLL_MAX_BACKOFF_MS=2000
WORKER_HEARTBEAT_INTERVAL_S=10
WORKER_SHUTDOWN_GRACE_S=30

# --- Scheduler / reaper (used from Day 2) ------------------------------------
SCHEDULER_TICK_INTERVAL_S=1
REAPER_INTERVAL_S=30
WORKER_DEAD_AFTER_S=60
