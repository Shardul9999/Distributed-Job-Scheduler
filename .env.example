# Copy to .env before running `docker compose up`.
# Every value below has a working default in docker-compose.yml; this file
# documents the full configuration surface.

# --- Database ----------------------------------------------------------------
POSTGRES_USER=codity
POSTGRES_PASSWORD=codity_dev_password
POSTGRES_DB=codity
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- API ---------------------------------------------------------------------
API_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Auth --------------------------------------------------------------------
# CHANGE THIS. Generate with: openssl rand -hex 32
JWT_SECRET_KEY=dev_only_secret_change_me_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Worker (used from Day 1) ------------------------------------------------
WORKER_CONCURRENCY=10
WORKER_POLL_INTERVAL_MS=100
WORKER_POLL_MAX_BACKOFF_MS=2000
WORKER_HEARTBEAT_INTERVAL_S=10
WORKER_SHUTDOWN_GRACE_S=30

# --- Scheduler / reaper (used from Day 2) ------------------------------------
# Cron resolution. One second is the finest a five-field cron can express.
SCHEDULER_TICK_MS=1000
# How long a standby waits before trying for the leader lock again.
SCHEDULER_LOCK_RETRY_S=5
# Reaper cadence. Keep well below the shortest queue visibility_timeout_s.
REAPER_INTERVAL_S=30
# A worker silent for this long is declared dead and its jobs recovered.
# Six times WORKER_HEARTBEAT_INTERVAL_S: tolerant of a GC pause, intolerant
# of an actual crash.
WORKER_HEARTBEAT_TIMEOUT_S=60
# worker_heartbeats retention; trimmed in batches by the reaper.
HEARTBEAT_RETENTION_HOURS=24

# --- Dashboard (used from Day 3) ---------------------------------------------
# Host port the Next.js dashboard is exposed on.
WEB_PORT=3000
# API base URL as seen from the *browser*. The dashboard calls the API directly
# over CORS at the host-exposed port, not the docker-network service name.
NEXT_PUBLIC_API_BASE=http://localhost:8000/api/v1
